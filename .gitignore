# Build artifact — the seeded Claude Design payload (~2 MB, regenerate via design/seed)
design/ai-capacity-planner-wireframe.html

# Third-party / copyrighted source binaries — kept locally for reference only, NOT redistributed.
# Source URLs are logged in research/sources/README.md.
research/sources/*.pdf
research/sources/*.zip
research/sources/*.xlsm
research/sources/*.skill

# Node
node_modules/
dist/

# WASM build artifacts (`make wasm` produces both; wasm_exec.js is copied from GOROOT)
web/public/engine.wasm
web/public/wasm_exec.js

# Staged by `make deploy` for the Cloud Build upload; deploy/Dockerfile is the source of truth
/Dockerfile

# OS / editor cruft
.DS_Store
*.swp

# Harness run artifacts (WS10 force-adds one reviewed run — never its trace.zip or .webm, which are
# 100+ MB; those stay local: `npx playwright show-trace harness/runs/<ts>/trace.zip`)
harness/runs/
harness/runs/**/trace.zip
harness/runs/**/*.webm
harness/test-results/
