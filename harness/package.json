{
  "name": "capplanner-harness",
  "private": true,
  "version": "0.0.0",
  "description": "Playwright remote-control harness for the capacity planner SPA: a Session helper over window.__harness, the smoke test (WS9) and the acceptance session (WS10).",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "smoke": "playwright test tests/smoke.spec.ts",
    "acceptance": "COPILOT_MODE=scripted playwright test acceptance/",
    "acceptance:live": "COPILOT_MODE=live HARNESS_VIDEO=${HARNESS_VIDEO-1} playwright test acceptance/abilene-1.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "typescript": "5.9.3"
  }
}
